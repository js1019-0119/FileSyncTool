/* ============================================================
   FileSyncTool 全局样式（浅色主题）
   ============================================================ */

QWidget {
    font-family: "Microsoft YaHei", "Segoe UI", "PingFang SC", sans-serif;
    color: #202124;
}

QMainWindow, QDialog {
    background: #f4f5f7;
}

/* ---------------- 菜单栏 ---------------- */
QMenuBar {
    background: #ffffff;
    border-bottom: 1px solid #e3e5e8;
    padding: 2px 6px;
}
QMenuBar::item {
    padding: 5px 12px;
    background: transparent;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background: #e8f0fe;
    color: #1a73e8;
}
QMenu {
    background: #ffffff;
    border: 1px solid #d8dbe0;
    padding: 4px;
}
QMenu::item {
    padding: 6px 28px 6px 22px;
    border-radius: 4px;
}
QMenu::item:selected {
    background: #e8f0fe;
    color: #1a73e8;
}
QMenu::separator {
    height: 1px;
    background: #e3e5e8;
    margin: 4px 8px;
}

/* ---------------- 按钮 ---------------- */
QPushButton {
    background: #ffffff;
    border: 1px solid #c9ccd1;
    border-radius: 5px;
    padding: 5px 14px;
    min-height: 18px;
}
QPushButton:hover {
    background: #f1f3f4;
    border-color: #9aa0a6;
}
QPushButton:pressed {
    background: #e4e7ea;
}
QPushButton:disabled {
    color: #a0a4aa;
    background: #f6f7f8;
    border-color: #e0e2e5;
}

/* ---------------- 输入框 / 下拉框 ---------------- */
QLineEdit, QComboBox {
    background: #ffffff;
    border: 1px solid #c9ccd1;
    border-radius: 5px;
    padding: 4px 8px;
    min-height: 20px;
}
QLineEdit:focus, QComboBox:focus {
    border-color: #1a73e8;
}
QLineEdit:read-only {
    background: #f6f7f8;
}
QComboBox::drop-down {
    border: none;
    width: 22px;
}
QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #d8dbe0;
    selection-background-color: #e8f0fe;
    selection-color: #1a73e8;
}

/* ---------------- 表格 ---------------- */
QTableView {
    background: #ffffff;
    alternate-background-color: #f8f9fa;
    border: 1px solid #e3e5e8;
    gridline-color: transparent;
    selection-background-color: #d2e3fc;
    selection-color: #202124;
}
QHeaderView::section {
    background: #f1f3f4;
    color: #5f6368;
    border: none;
    border-bottom: 1px solid #e3e5e8;
    border-right: 1px solid #eceef0;
    padding: 5px 8px;
    font-weight: bold;
}

/* ---------------- 进度条 ---------------- */
QProgressBar {
    background: #e3e5e8;
    border: none;
    border-radius: 6px;
    text-align: center;
    color: #202124;
    font-size: 11px;
    min-height: 16px;
}
QProgressBar::chunk {
    background: #1a73e8;
    border-radius: 6px;
}

/* ---------------- 分组框 ---------------- */
QGroupBox {
    border: 1px solid #e3e5e8;
    border-radius: 6px;
    background: #ffffff;
    margin-top: 10px;
    padding-top: 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: #5f6368;
    font-weight: bold;
    background: transparent;
}

/* ---------------- 分隔条 ---------------- */
QSplitter::handle {
    background: #e3e5e8;
}
QSplitter::handle:hover {
    background: #1a73e8;
}
QSplitter::handle:horizontal {
    width: 4px;
}
QSplitter::handle:vertical {
    height: 4px;
}

/* ---------------- 状态栏 ---------------- */
QStatusBar {
    background: #ffffff;
    border-top: 1px solid #e3e5e8;
    color: #5f6368;
}

/* ---------------- 滚动条 ---------------- */
QScrollBar:vertical {
    background: #f1f3f4;
    width: 10px;
    border-radius: 5px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #c1c5cb;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #9aa0a6;
}
QScrollBar:horizontal {
    background: #f1f3f4;
    height: 10px;
    border-radius: 5px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #c1c5cb;
    border-radius: 5px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #9aa0a6;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}

/* ---------------- 提示 ---------------- */
QToolTip {
    background: #202124;
    color: #ffffff;
    border: none;
    padding: 4px 8px;
    border-radius: 4px;
}
